# ───────── Discord ─────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Primary Super Admin (bot owner). Extra Super Admins: comma-separated IDs.
BOT_OWNER_ID=your_discord_user_id_here
SUPER_ADMIN_IDS=

# ───────── Database (PostgreSQL only) ─────────
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dcbot
# true | false | auto  (auto = enable TLS unless host is localhost)
DATABASE_SSL=auto
DATABASE_POOL_MAX=10

# ───────── Minecraft AFK subscription system ─────────
MASTER_SERVER_ID=your_master_discord_server_id_here
OWO_BOT_ID=408785106942164992
SUBSCRIPTION_AMOUNT=25000000
SUBSCRIPTION_DAYS=30
# Shared API key sent to every slot. Prefer setting it here.
GLOBAL_API_KEY=
# 32-byte key (64 hex chars or base64). Required only if you want /setkey to
# persist a key in the database (it is stored AES-256-GCM encrypted).
SECRETS_ENCRYPTION_KEY=
# query = ?key=... (legacy, default)   header = x-api-key header
AFK_API_KEY_MODE=query
# Set true only if your slot APIs live on private/loopback addresses.
ALLOW_PRIVATE_SLOT_URLS=false

# ───────── Fun module (optional GIF provider) ─────────
# none | giphy
GIF_PROVIDER=none
GIF_API_KEY=

# ───────── Economy games (DarkEssence) ─────────
DAILY_AMOUNT=500
COINFLIP_MAX_BET=50000
# Every Nth coin flip per user is a guaranteed loss.
COINFLIP_FORCED_LOSS_EVERY=7
# true = players see "flip 3/7" in the result footer; false = hide the counter
COINFLIP_SHOW_COUNTER=true

# ───────── Anti-nuke (per-person, per-event-type) ─────────
# Triggers when MORE than THRESHOLD actions happen inside the window.
ANTINUKE_THRESHOLD=3
ANTINUKE_WINDOW_SECONDS=60

# ───────── Runtime ─────────
# Render injects PORT automatically; HEALTH_PORT overrides it.
HEALTH_PORT=3000
LOG_LEVEL=info
